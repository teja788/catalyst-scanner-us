# Optional API keys. The CORE scanner (EDGAR + RSS) needs NONE of these.
# Copy this file to ".env" and fill in only what you want to enable.

# Finnhub (free, 60 calls/min) — only used if you set news.finnhub_enabled: true
# in config/settings.yaml. Reserved for market-news + targeted `ask` pulls, not a
# per-ticker sweep over the whole universe.
FINNHUB_API_KEY=

# Optional LLM scorer (config/settings.yaml -> scoring.mode: llm_api) — future hook.
# Read INSIDE the scorer functions only, never at import time.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
