# Optional API keys. The CORE scanner (EDGAR + RSS) needs NONE of these.
# Copy this file to ".env" and fill in only what you want to enable.

# Dashboard AI rank/chat panels (API-key engines only; the dashboard also accepts
# the key in its sidebar). Read INSIDE the scorer functions only, never at import.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# USPTO PatentsView (free key) — without it the patents feed is skipped.
PATENTSVIEW_API_KEY=
